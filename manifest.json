{
  "manifest_version": 2,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "1.0.0",
  "author": "Patrick Grossmann",
  "homepage_url": "https://github.com/patrickbgrossmann/compose-calendar",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "compose-calendar@invitris.com",
      "strict_min_version": "115.0",
      "strict_max_version": "199.*"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "experiment_apis": {
    "composeCalendar": {
      "schema": "api/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["composeCalendar"]],
        "script": "api/api.js"
      }
    }
  },
  "compose_action": {
    "default_title": "__MSG_buttonTitle__",
    "default_label": "__MSG_buttonLabel__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup/popup.html"
  },
  "permissions": [
    "accountsRead",
    "messagesRead",
    "compose",
    "storage"
  ]
}
